{
  "name": "ignis",
  "services": {
    "site": {
      "image": "nginx:alpine",
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/ignis/public",
          "target": "/usr/share/nginx/html",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/opt/ignis/nginx.conf",
          "target": "/etc/nginx/conf.d/default.conf",
          "read_only": true
        }
      ],
      "networks": [
        "proxy"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "n8n_default",
        "traefik.http.services.ignis.loadbalancer.server.port": "80",
        "traefik.http.routers.ignis.rule": "Host(`ignis.farm`)",
        "traefik.http.routers.ignis.entrypoints": "websecure",
        "traefik.http.routers.ignis.tls": "true",
        "traefik.http.routers.ignis.tls.certresolver": "mytlschallenge",
        "traefik.http.routers.ignis.service": "ignis",
        "traefik.http.routers.ignis-www.rule": "Host(`www.ignis.farm`)",
        "traefik.http.routers.ignis-www.entrypoints": "websecure",
        "traefik.http.routers.ignis-www.tls": "true",
        "traefik.http.routers.ignis-www.tls.certresolver": "mytlschallenge",
        "traefik.http.routers.ignis-www.service": "ignis",
        "traefik.http.routers.ignis-www.middlewares": "ignis-canonical",
        "traefik.http.middlewares.ignis-canonical.redirectregex.regex": "^https://www[.]ignis[.]farm/(.*)",
        "traefik.http.middlewares.ignis-canonical.redirectregex.replacement": "https://ignis.farm/$${1}",
        "traefik.http.middlewares.ignis-canonical.redirectregex.permanent": "true",
        "traefik.http.routers.ignis.middlewares": "ignis-auth"
      }
    },
    "auth": {
      "image": "ghcr.io/tinyauthapp/tinyauth:v5",
      "restart": "unless-stopped",
      "env_file": [
        "/opt/ignis/auth.env"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "auth_data",
          "target": "/data"
        }
      ],
      "networks": [
        "proxy"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "n8n_default",
        "traefik.http.routers.ignis-auth.rule": "Host(`auth.ignis.farm`)",
        "traefik.http.routers.ignis-auth.entrypoints": "websecure",
        "traefik.http.routers.ignis-auth.tls": "true",
        "traefik.http.routers.ignis-auth.tls.certresolver": "mytlschallenge",
        "traefik.http.services.ignis-auth.loadbalancer.server.port": "3000",
        "traefik.http.middlewares.ignis-auth.forwardauth.address": "http://ignis-auth-1:3000/api/auth/traefik",
        "traefik.http.middlewares.ignis-auth.forwardauth.authResponseHeaders": "Remote-Email",
        "traefik.http.middlewares.ignis-auth.forwardauth.trustForwardHeader": "true"
      }
    }
  },
  "networks": {
    "proxy": {
      "external": true,
      "name": "n8n_default"
    }
  },
  "volumes": {
    "auth_data": {
      "name": "ignis_auth_data"
    }
  }
}