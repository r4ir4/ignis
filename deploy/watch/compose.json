{
  "name": "ignis-watch",
  "services": {
    "watch-site": {
      "image": "nginx:alpine",
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run"
      ],
      "volumes": [
        "/opt/ignis/watch/public:/usr/share/nginx/html:ro",
        "/opt/ignis/watch/nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "networks": [
        "proxy",
        "watch"
      ],
      "depends_on": [
        "watch-api"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "n8n_default",
        "traefik.http.services.ignis-watch.loadbalancer.server.port": "80",
        "traefik.http.routers.ignis-watch.rule": "Host(`watch.ignis.farm`)",
        "traefik.http.routers.ignis-watch.entrypoints": "websecure",
        "traefik.http.routers.ignis-watch.tls": "true",
        "traefik.http.routers.ignis-watch.tls.certresolver": "mytlschallenge",
        "traefik.http.routers.ignis-watch.service": "ignis-watch",
        "traefik.http.routers.ignis-watch.middlewares": "ignis-auth@docker"
      }
    },
    "watch-api": {
      "build": {
        "context": "/opt/ignis/watch/api"
      },
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ],
      "environment": {
        "IGNIS_WATCH_DATA": "/data",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "volumes": [
        "/opt/ignis/watch/data:/data"
      ],
      "networks": [
        "watch",
        "egress"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  },
  "networks": {
    "proxy": {
      "external": true,
      "name": "n8n_default"
    },
    "watch": {
      "internal": true
    },
    "egress": {}
  }
}
